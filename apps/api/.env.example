PORT=3001
DATABASE_PATH=./data/kebs.db
DATABASE_URL="file:./data/kebs.db"
JWT_SECRET=change-me
SMS_WEBHOOK_SECRET=change-me
SMS_API_KEY=
SMS_SHORTCODE=20880
SMS_USERNAME=
PUBLIC_VERIFY_URL=http://localhost:3000/verify
VERIFY_FLAG_THRESHOLD=5
# Public base URL of this API. Set automatically by `npm run dev:tunnel`.
PUBLIC_API_URL=
# cloudflare | ngrok | auto (default: auto)
TUNNEL_PROVIDER=auto
# Trusted reverse-proxy hops in front of the API (0 = none). `dev:tunnel` sets 1 itself.
TRUST_PROXY=0
