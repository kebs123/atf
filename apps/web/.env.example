# Express origin for local Vite proxy (`npm run dev`).
# On Cloudflare Pages the browser calls same-origin `/api`; set the Pages secret API_ORIGIN instead.
VITE_API_BASE_URL=

# Public SMS copy only. Africa's Talking API keys stay on the backend.
VITE_SMS_SHORTCODE=
VITE_SMS_KEYWORD=KEBS

# Public Mapbox token (pk.*). Copy to .env — never commit a real token.
VITE_MAPBOX_ACCESS_TOKEN=

# Mapbox Studio → your "Streets" style → Share → Style URL
# Example: mapbox://styles/your-username/clxxxxxxxx
VITE_MAPBOX_STYLE=
