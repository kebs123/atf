generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum CompanyStatus {
  pending
  approved
  suspended
}

enum UserRole {
  manufacturer
  retailer
  admin
}

enum ProductCategory {
  medicine
  food
  cosmetic
  alcohol
  other
}

enum BatchStatus {
  active
  recalled
}

enum UnitStatus {
  unused
  verified
  recalled
  flagged
}

enum VerificationChannel {
  sms
  web
}

enum VerificationResult {
  genuine
  already_verified
  recalled
  expired
  unknown
  flagged
}

enum HolderType {
  factory
  distributor
  retailer
}

model Company {
  id        Int           @id @default(autoincrement())
  name      String
  country   String
  status    CompanyStatus @default(pending)
  createdAt DateTime      @default(now()) @map("created_at")
  users     User[]
  products  Product[]

  @@map("companies")
}

model User {
  id             Int            @id @default(autoincrement())
  companyId      Int?           @map("company_id")
  company        Company?       @relation(fields: [companyId], references: [id])
  email          String         @unique
  passwordHash   String         @map("password_hash")
  role           UserRole
  createdAt      DateTime       @default(now()) @map("created_at")
  custodyEvents  CustodyEvent[]

  @@map("users")
}

model Product {
  id          Int             @id @default(autoincrement())
  companyId   Int             @map("company_id")
  company     Company         @relation(fields: [companyId], references: [id])
  name        String
  sku         String?
  category    ProductCategory
  description String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  batches     Batch[]

  @@unique([companyId, sku])
  @@map("products")
}

model Batch {
  id              Int         @id @default(autoincrement())
  productId       Int         @map("product_id")
  product         Product     @relation(fields: [productId], references: [id])
  batchNumber     String      @map("batch_number")
  manufacturedAt  DateTime?   @map("manufactured_at")
  expiresAt       DateTime?   @map("expires_at")
  factoryLocation String?     @map("factory_location")
  quantity        Int
  codesGenerated  Int         @default(0) @map("codes_generated")
  status          BatchStatus @default(active)
  recalledAt      DateTime?   @map("recalled_at")
  recallReason    String?     @map("recall_reason")
  createdAt       DateTime    @default(now()) @map("created_at")
  units           Unit[]

  @@unique([productId, batchNumber])
  @@map("batches")
}

model Unit {
  id                Int             @id @default(autoincrement())
  batchId           Int             @map("batch_id")
  batch             Batch           @relation(fields: [batchId], references: [id])
  verificationCode  String          @unique @map("verification_code")
  status            UnitStatus      @default(unused)
  firstVerifiedAt   DateTime?       @map("first_verified_at")
  verifyCount       Int             @default(0) @map("verify_count")
  currentHolderType HolderType?     @map("current_holder_type")
  currentHolderName String?         @map("current_holder_name")
  createdAt         DateTime        @default(now()) @map("created_at")
  verifications     Verification[]
  custodyEvents     CustodyEvent[]
  reports           Report[]

  @@index([batchId])
  @@map("units")
}

model Verification {
  id               Int                 @id @default(autoincrement())
  unitId           Int?                @map("unit_id")
  unit             Unit?               @relation(fields: [unitId], references: [id])
  codeSubmitted    String              @map("code_submitted")
  channel          VerificationChannel
  result           VerificationResult
  actorPhoneHash   String?             @map("actor_phone_hash")
  actorIp          String?             @map("actor_ip")
  gatewayMessageId String?             @unique @map("gateway_message_id")
  createdAt        DateTime            @default(now()) @map("created_at")

  @@index([unitId])
  @@index([createdAt])
  @@map("verifications")
}

model CustodyEvent {
  id              Int      @id @default(autoincrement())
  unitId          Int      @map("unit_id")
  unit            Unit     @relation(fields: [unitId], references: [id])
  fromParty       String   @map("from_party")
  toParty         String   @map("to_party")
  location        String?
  createdByUserId Int?     @map("created_by_user_id")
  createdBy       User?    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("custody_events")
}

model Report {
  id            Int                 @id @default(autoincrement())
  unitId        Int?                @map("unit_id")
  unit          Unit?               @relation(fields: [unitId], references: [id])
  codeSubmitted String              @map("code_submitted")
  channel       VerificationChannel
  note          String?
  createdAt     DateTime            @default(now()) @map("created_at")

  @@map("reports")
}

model SmsTemplate {
  id        Int    @id @default(autoincrement())
  result    String
  language  String @default("en")
  body      String

  @@unique([result, language])
  @@map("sms_templates")
}
